# ================================================================
#  CleanPad — .gitignore
#  Rust + Tauri v2 / Node.js / Vite
# ================================================================

# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Frontend Build Output ───────────────────────────────────────
dist/
dist-isolation/

# ── Rust & Tauri Build Output ───────────────────────────────────
src-tauri/target/
target/
release/

# ── Logs & Temporary Files ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor & IDE folders ─────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo

# ── OS junk ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store