# ================================================================
#  CleanPad — .gitignore
#  Rust + Tauri v2 / Node.js / Vite / C++ MSVC
# ================================================================

# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Build Output ────────────────────────────────────────────────
dist/
dist-isolation/
CleanPad/output/
src-tauri/target/
target/

# ── Logs & Temporary Files ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── MSVC compiler intermediates ──────────────────────────────────
*.obj
*.res
*.pdb
*.ilk
*.exp
*.lib

# ── Editor & IDE folders ─────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo

# ── OS junk ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store