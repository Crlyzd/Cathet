# ================================================================
#  CleanPad — .gitignore
#  Rust + Tauri v2 / Node.js / Vite
# ================================================================

# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Frontend Build Output ───────────────────────────────────────
dist/
dist-isolation/

# ── Rust & Tauri Build Output ───────────────────────────────────
src-tauri/target/
target/
release/

# ── Tauri v2 Generated Mobile Wrappers & Schemas ────────────────
# src-tauri/gen/
src-tauri/gen/schemas/
**/gen/android/.gradle/
**/gen/android/build/
**/gen/android/app/build/
**/gen/android/.cxx/
**/gen/android/local.properties
*.jks
*.keystore
*.priv.asc
*.priv.gpg
*.key
*.p12
*.pfx

# ── Logs & Temporary Files ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor & IDE folders ─────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo

# ── OS junk ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store